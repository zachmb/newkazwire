[Unit]
Description=Kazwire proxy transport server (Wisp + legacy bare fallback)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/kazwire
Environment=NODE_ENV=production
Environment=BARE_HOST=127.0.0.1
Environment=BARE_PORT=8080
Environment=WISP_PATH=/w/
# Combined server: Wisp on /w/ (the transport UV 3.x actually uses) + the legacy
# @tomphttp bare relay on /bare/ as a dormant fallback, in one process on :8080.
ExecStart=/usr/bin/node server/proxy-server.cjs
Restart=always
RestartSec=3
User=kazwire
Group=kazwire

[Install]
WantedBy=multi-user.target
